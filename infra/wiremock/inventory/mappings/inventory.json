{
  "mappings": [
    {
      "name": "out of stock",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/api/v1/inventory/reservations",
        "bodyPatterns": [{ "matchesJsonPath": "$.items[?(@.sku == 'OUT-OF-STOCK')]" }]
      },
      "response": { "status": 409 }
    },
    {
      "name": "reserve",
      "priority": 5,
      "request": { "method": "POST", "urlPath": "/api/v1/inventory/reservations" },
      "response": { "status": 201 }
    },
    {
      "name": "release (compensation)",
      "request": { "method": "DELETE", "urlPathPattern": "/api/v1/inventory/reservations/.*" },
      "response": { "status": 200 }
    }
  ]
}
